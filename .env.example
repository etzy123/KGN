# Verplicht voor opnemen en AI-herkenning (gratis key via console.groq.com/keys)
GROQ_API_KEY=
# Pincode om de app te openen (aanrader, anders kan iedereen met de link erin)
APP_PIN=
# Map voor prijzen, bedrijfsgegevens en offertenummer (koppel hier een Railway volume)
DATA_DIR=/data
# Optioneel
STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-120b
