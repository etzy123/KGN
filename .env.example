# Verplicht voor opnemen en AI-herkenning (gratis key via console.groq.com/keys)
GROQ_API_KEY=
# Pincode om de app te openen (aanrader, anders kan iedereen met de link erin)
APP_PIN=
# Map voor offertes, facturen, foto's en instellingen (koppel hier een Railway volume)
DATA_DIR=/data
# Optioneel: betalen met iDEAL via Mollie
MOLLIE_API_KEY=
# Optioneel: vast adres van de app voor links en de Mollie-webhook
PUBLIC_URL=
# Optioneel
STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-120b
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
FOLLOWUP_DAYS=7
